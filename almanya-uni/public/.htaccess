<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # ──────────────────────────────────────────────────────────────────────
    # Kanonikleştirme: her istek TEK bir adrese, TEK sıçramada.
    #   hedef = https://applytogerman.com/<yol>
    #
    # Neden gerekli oldu: http:// sürümü 200 dönüyordu ve canonical etiketi
    # isteğin şemasından üretildiği için kendini http:// olarak işaretliyordu.
    # Sonuç: 23.858 URL'lik sitenin iki tam kopyası ve bölünmüş sıralama sinyali.
    #
    # %{HTTPS} neden güvenli: TLS doğrudan Apache'de sonlanıyor — 2026-09-23'te
    # /_system/proxy-check ile doğrulandı (HTTPS='on', REQUEST_SCHEME='https',
    # hiç X-Forwarded-* başlığı yok). Önde reverse proxy olsaydı Apache HTTPS'i
    # "off" görür ve bu kural sonsuz döngü yaratırdı; o yüzden kural yazılmadan
    # önce ölçüldü. Proxy sonradan araya girerse bu kural X-Forwarded-Proto
    # kontrolüyle güncellenmeli.
    #
    # Sıra önemli: eski alan adı ve www kuralları hedefi zaten https verdiği
    # için önce onlar çalışır — böylece hiçbir durumda zincir oluşmaz.
    # ──────────────────────────────────────────────────────────────────────

    # 1) Eski marka alan adı → kanonik alan adı (şema ve www fark etmeksizin tek 301)
    RewriteCond %{HTTP_HOST} ^(www\.)?almanyauni\.com$ [NC]
    RewriteRule ^ https://applytogerman.com%{REQUEST_URI} [L,R=301]

    # 2) www. → çıplak alan adı, hedef her zaman https
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

    # 3) Kalan düz HTTP istekleri → https (aynı host)
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# ─────────────────────────────────────────────────────────────
# Performance — gzip compression + browser cache headers
# (Lighthouse Performance: "Serve static assets with efficient cache policy")
# Tüm bloklar IfModule içinde — modül yoksa sessiz geçer (KAS-safe)
# ─────────────────────────────────────────────────────────────

# Compression — text-based assets gzip
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/x-javascript
    AddOutputFilterByType DEFLATE application/json application/xml application/rss+xml
    AddOutputFilterByType DEFLATE application/xhtml+xml application/atom+xml
    AddOutputFilterByType DEFLATE image/svg+xml font/woff font/woff2
</IfModule>

# Cache expiration headers
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresDefault "access plus 1 month"

    # HTML — taze tut (içerik değişebilir)
    ExpiresByType text/html "access plus 0 seconds"

    # XML/JSON feeds — kısa (sitemap, RSS güncel kalsın)
    ExpiresByType application/xml "access plus 1 hour"
    ExpiresByType application/rss+xml "access plus 1 hour"
    ExpiresByType application/json "access plus 0 seconds"

    # Fonts — uzun (immutable)
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"

    # CSS/JS — uzun (Vite hash-based filename'lerle build ediliyor, güvenli)
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"

    # Images — 6 ay
    ExpiresByType image/jpeg "access plus 6 months"
    ExpiresByType image/png "access plus 6 months"
    ExpiresByType image/webp "access plus 6 months"
    ExpiresByType image/avif "access plus 6 months"
    ExpiresByType image/svg+xml "access plus 6 months"
    ExpiresByType image/x-icon "access plus 1 year"
    ExpiresByType image/vnd.microsoft.icon "access plus 1 year"

    # PWA manifest — kısa (güncellemeler için)
    ExpiresByType application/manifest+json "access plus 1 day"
</IfModule>

# Cache-Control headers — modern, mod_expires üzerine
<IfModule mod_headers.c>
    # Vite hash'li assets (build/) — sonsuza dek cache (filename değişince yeniden iner)
    <FilesMatch "^.*\.(woff2|woff|ttf|eot|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
</IfModule>

